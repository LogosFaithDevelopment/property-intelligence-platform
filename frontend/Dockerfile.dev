# =============================================================================
# DEVELOPMENT DOCKERFILE
# Property Intelligence Platform - Frontend (Next.js)
# For local development with hot reload
# =============================================================================

FROM node:20-alpine

WORKDIR /frontend

# Install dependencies
# Note: We copy package files first for better layer caching
COPY package.json package-lock.json* ./

# Install ALL dependencies (including devDependencies for development)
RUN npm ci

# Copy the rest of the application
# Note: Source code will be mounted as a volume in docker-compose.yml
# This COPY is just for initial setup
COPY . .

# Set development environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Expose port 3000
EXPOSE 3000

# Start Next.js development server with hot reload
# The --hostname 0.0.0.0 allows connections from outside the container
CMD ["npm", "run", "dev"]
