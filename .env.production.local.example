# =============================================================================
# PRODUCTION TESTING ENVIRONMENT - LOCAL DOCKER COMPOSE
# =============================================================================
# This file is a template for local production testing with docker-compose.prod.yml
# 
# USAGE:
#   1. Copy this file to .env.production.local
#   2. Fill in all required values
#   3. Run: docker-compose -f docker-compose.prod.yml up --build
#
# SECURITY: Never commit .env.production.local to git!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (EXTERNAL - NOT IN DOCKER COMPOSE)
# -----------------------------------------------------------------------------
# Option 1: Local PostgreSQL on host machine
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/property_intel

# Option 2: Test RDS instance
# DATABASE_URL=postgresql://admin:SecurePassword123@property-intel-test.abc123.us-east-1.rds.amazonaws.com:5432/property_intel_test

# Option 3: Cloud database provider (e.g., Supabase, Neon, etc.)
# DATABASE_URL=postgresql://user:password@db.provider.com:5432/dbname

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/property_intel

# -----------------------------------------------------------------------------
# REDIS (OPTIONAL - Included in docker-compose.prod.yml)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# -----------------------------------------------------------------------------
# Backend secret key (sk_test_* for development, sk_live_* for production)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Webhook secret (get from Clerk Dashboard -> Webhooks)
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here

# Frontend publishable key (pk_test_* for development, pk_live_* for production)
# REQUIRED: This is needed during Docker build process for Next.js prerendering
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS
# -----------------------------------------------------------------------------
# OpenAI API Key (for AI-powered assessments)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ATTOM Property API Key (property data enrichment)
ATTOM_API_KEY=your_attom_api_key_here

# Smarty Streets API Credentials (address validation)
SMARTY_AUTH_ID=your_smarty_auth_id_here
SMARTY_AUTH_TOKEN=your_smarty_auth_token_here

# Census API Key (demographics data - optional)
CENSUS_API_KEY=your_census_api_key_here

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API URL (as seen from frontend container)
NEXT_PUBLIC_API_URL=http://backend:8000

# Environment indicator
NEXT_PUBLIC_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# LOGGING & MONITORING (OPTIONAL)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your_sentry_dsn_here

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# QUICK START GUIDE
# -----------------------------------------------------------------------------
# 1. Copy this file:
#    cp .env.production.local.example .env.production.local
#
# 2. Update DATABASE_URL to point to an accessible PostgreSQL instance
#
# 3. Fill in Clerk API keys (get from https://dashboard.clerk.com)
#
# 4. Fill in other API keys (OpenAI, ATTOM, Smarty Streets)
#
# 5. Build and start services:
#    docker-compose -f docker-compose.prod.yml up --build
#
# 6. Access application:
#    Frontend: http://localhost:3000
#    Backend:  http://localhost:8000
#    Health:   http://localhost:8000/health
#
# 7. View logs:
#    docker-compose -f docker-compose.prod.yml logs -f
#
# 8. Stop services:
#    docker-compose -f docker-compose.prod.yml down
#
# -----------------------------------------------------------------------------
# TROUBLESHOOTING
# -----------------------------------------------------------------------------
# Database connection fails:
#   - Ensure PostgreSQL is running and accessible
#   - Check DATABASE_URL format and credentials
#   - Try: docker-compose -f docker-compose.prod.yml logs backend
#
# Frontend can't reach backend:
#   - Check NEXT_PUBLIC_API_URL uses container name "backend"
#   - Verify both services are on same network
#   - Check backend health: curl http://localhost:8000/health
#
# Health checks failing:
#   - Wait for start_period to elapse (30-40 seconds)
#   - Check service logs for errors
#   - Verify ports are not already in use
# -----------------------------------------------------------------------------
