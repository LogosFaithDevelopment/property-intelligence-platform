# =============================================================================
# BACKEND ENVIRONMENT VARIABLES - PRODUCTION TEMPLATE
# =============================================================================
# This file documents all required environment variables for the FastAPI backend.
#
# USAGE:
#   - For LOCAL development: Copy to .env and fill in values
#   - For PRODUCTION (AWS ECS): Store ALL values in AWS Secrets Manager
#   - NEVER commit actual .env files with real values to git
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Environment name (development, staging, production)
ENVIRONMENT=development

# Secret key for JWT tokens and session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug mode (MUST be false in production)
DEBUG=false

# Allowed hosts for production (comma-separated)
# Example: app.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins (comma-separated, no trailing slashes)
# Local:      http://localhost:3000
# Production: https://app.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Local Development (Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_intel

# AWS RDS Production Format:
# DATABASE_URL=postgresql://username:password@rds-endpoint.region.rds.amazonaws.com:5432/dbname
#
# Example:
# DATABASE_URL=postgresql://admin:SecurePassword123@property-intel-prod.c9xyz.us-east-1.rds.amazonaws.com:5432/property_intel_prod
#
# RDS Production Specs:
#   - Instance: db.t4g.micro (2 vCPU, 1GB RAM) ~$17-22/month
#   - Storage: 20GB GP3 with autoscaling to 100GB
#   - Backup: 7-day automated backups
#   - Multi-AZ: Disabled (enable if high availability needed)
#   - VPC: Private subnet, no public access
#   - Security Group: Allow PostgreSQL (5432) from ECS security group only
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_intel

# Database connection pool settings (optional, has defaults)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# REDIS (Optional - for caching/sessions)
# -----------------------------------------------------------------------------
# Local:      redis://localhost:6379
# Production: redis://your-elasticache-endpoint:6379
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# -----------------------------------------------------------------------------
# Clerk secret key (backend validation)
# Development: sk_test_... (from Clerk Dashboard -> API Keys)
# Production:  sk_live_... (from Clerk Production App)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk webhook secret (for validating webhook requests)
# Get this from Clerk Dashboard -> Webhooks -> Add Endpoint
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS
# -----------------------------------------------------------------------------
# OpenAI API Key (for AI-powered assessment analysis)
# Get from: https://platform.openai.com/api-keys
# Production: Verify rate limits and quota
OPENAI_API_KEY=your_openai_api_key_here

# ATTOM Property API Key (property data enrichment)
# Get from: https://api.attomdata.com/
# Production: Verify production tier and request limits
ATTOM_API_KEY=your_attom_api_key_here

# Smarty Streets API Credentials (address validation & enrichment)
# Get from: https://www.smarty.com/
# Production: Verify production auth-id and auth-token
SMARTY_AUTH_ID=your_smarty_auth_id_here
SMARTY_AUTH_TOKEN=your_smarty_auth_token_here

# Census API Key (demographics data - optional, mostly keyless)
# Get from: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# For sending reports, notifications, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable JSON structured logging for production (CloudWatch compatibility)
# LOG_FORMAT=json

# -----------------------------------------------------------------------------
# AWS CONFIGURATION (Production)
# -----------------------------------------------------------------------------
# AWS region for RDS, Secrets Manager, etc.
# AWS_REGION=us-east-1

# S3 bucket for report storage (optional)
# AWS_S3_BUCKET=property-intel-reports
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# -----------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT NOTES
# -----------------------------------------------------------------------------
# When deploying to AWS ECS Fargate:
#
# 1. Create AWS Secrets Manager secret:
#    aws secretsmanager create-secret \
#      --name property-intel/backend/production \
#      --secret-string file://secrets.json \
#      --region us-east-1
#
#    Where secrets.json contains:
#    {
#      "DATABASE_URL": "postgresql://admin:password@rds-endpoint:5432/dbname",
#      "SECRET_KEY": "generated-secret-key",
#      "CLERK_SECRET_KEY": "sk_live_...",
#      "OPENAI_API_KEY": "sk-...",
#      "ATTOM_API_KEY": "...",
#      "SMARTY_AUTH_ID": "...",
#      "SMARTY_AUTH_TOKEN": "..."
#    }
#
# 2. Configure ECS Task Definition to inject secrets:
#    {
#      "secrets": [
#        {
#          "name": "DATABASE_URL",
#          "valueFrom": "arn:aws:secretsmanager:region:account:secret:property-intel/backend/production:DATABASE_URL::"
#        },
#        {
#          "name": "SECRET_KEY",
#          "valueFrom": "arn:aws:secretsmanager:region:account:secret:property-intel/backend/production:SECRET_KEY::"
#        }
#        // ... repeat for all secrets
#      ]
#    }
#
# 3. Set non-secret environment variables directly in task definition:
#    {
#      "environment": [
#        {"name": "ENVIRONMENT", "value": "production"},
#        {"name": "DEBUG", "value": "false"},
#        {"name": "LOG_LEVEL", "value": "INFO"}
#      ]
#    }
#
# 4. RDS Database Setup:
#    - Create RDS instance in private subnet
#    - Note the endpoint: xxx.region.rds.amazonaws.com
#    - Create database: property_intel_prod
#    - Run migrations: alembic upgrade head
#    - Store credentials in Secrets Manager
#
# 5. Security Checklist:
#    ✓ DEBUG=false
#    ✓ SECRET_KEY is cryptographically random (32+ characters)
#    ✓ DATABASE_URL uses SSL: ?sslmode=require
#    ✓ ALLOWED_ORIGINS only includes production frontend URL
#    ✓ ALLOWED_HOSTS only includes production domain
#    ✓ All API keys are production-tier with appropriate rate limits
#    ✓ RDS is in private subnet with security group restricting access
#    ✓ Clerk production app is created with pk_live_*/sk_live_* keys
#
# 6. Health Checks:
#    - ECS will use /health endpoint (returns 200 OK)
#    - Database health: /api/v1/health/db (checks DB connection)
# -----------------------------------------------------------------------------
