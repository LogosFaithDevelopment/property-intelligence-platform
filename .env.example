# For Prod Environment Configuration - See env.production.local.bak
# Copy this file to .env and configure with your actual values

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_intel
REDIS_URL=redis://localhost:6379
SECRET_KEY=your-super-secret-key-change-this-in-production
ENVIRONMENT=development

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# API Keys
OPENAI_API_KEY=your_openai_api_key
CENSUS_API_KEY=your_census_api_key  
HUD_API_KEY=your_hud_api_key
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token
ATTOM_API_KEY=your_attom_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
RENTBERRY_API_KEY=your_rentberry_api_key

# Frontend Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=60
PREMIUM_API_RATE_LIMIT_PER_MINUTE=1000

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn
POSTHOG_API_KEY=your_posthog_api_key
